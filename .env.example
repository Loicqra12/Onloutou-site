# Site Next.js — copier vers `.env.local` à la racine du dépôt

# URL publique du site (SEO, sitemap) — optionnel en local
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base des appels API côté navigateur (proxy Next)
NEXT_PUBLIC_API_BASE=/api/v1

# Proxy serveur Next → API Express (non exposé au navigateur)
# Local : API sur la machine hôte
API_ORIGIN=http://127.0.0.1:4000
# Docker Compose (Next et API dans des conteneurs sur le même réseau) :
# API_ORIGIN=http://api:4000

# Désactiver les appels API (retour WhatsApp seul sur le contact)
# NEXT_PUBLIC_DISABLE_API=1
