{
  "name": "onloutou-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:motion": "playwright test tests/motion-regression.spec.ts",
    "test:captures": "playwright test tests/visual-captures.spec.ts tests/visual-video.spec.ts --project=desktop",
    "test:legal": "playwright test tests/legal-notice-page.spec.ts tests/privacy-policy-page.spec.ts tests/cookies-policy-page.spec.ts tests/cookies-policy-captures.spec.ts --project=desktop --workers=1",
    "test:final-audit": "playwright test tests/final-audit-captures.spec.ts --workers=1",
    "generate:route-inventory": "node scripts/generate-route-inventory.mjs",
    "test:responsive": "playwright test tests/responsive-audit.spec.ts --workers=1 --project=desktop",
    "test:responsive-captures": "playwright test tests/responsive-captures.spec.ts --workers=1 --project=desktop",
    "test:seo": "playwright test tests/seo-metadata.spec.ts tests/seo-routes.spec.ts tests/seo-structured-data.spec.ts tests/seo-domain-absent.spec.ts tests/seo-domain-fixture.spec.ts tests/seo-routes-classification.spec.ts --workers=1 --project=desktop",
    "test:performance": "playwright test tests/performance-budget.spec.ts --workers=1 --project=desktop",
    "audit:assets": "node scripts/audit-public-assets.mjs",
    "audit:performance": "node scripts/performance-audit.mjs",
    "audit:performance:summarize": "node scripts/performance-summarize.mjs",
    "optimize:lcp-images": "node scripts/optimize-lcp-images.mjs"
  },
  "dependencies": {
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
