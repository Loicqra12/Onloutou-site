# API ONLOUTOU — copier vers `backend/.env` (seul fichier lu par l’API)

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://onloutou:onloutou_dev@127.0.0.1:5433/onloutou

SESSION_SECRET=change-me-minimum-32-characters-long-secret
CSRF_SECRET=change-me-minimum-32-characters-csrf-secret

APP_ORIGIN=http://localhost:3000
# App admin Vite (http://127.0.0.1:3001). En prod : https://admin.onloutou.com
ADMIN_ORIGIN=http://127.0.0.1:3001
TRUST_PROXY=0
COOKIE_SECURE=0

# Tests d’intégration (base dédiée, jamais la prod)
# DATABASE_URL=postgresql://onloutou:onloutou_dev@127.0.0.1:5433/onloutou_integration

# Cloudinary — photos de fiches (publiques) et pièces confidentielles (type « authenticated »).
# Vide = les envois de fichiers répondent « stockage non configuré ».
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Brevo — e-mails via l'API HTTPS (clé « API » dans Brevo > SMTP & API, pas la clé SMTP).
# L'expéditeur doit être validé dans Brevo (et le domaine authentifié : SPF/DKIM/DMARC).
# Vide = aucun e-mail envoyé, les demandes sont quand même enregistrées.

# Les e-mails de vérification partenaire et de réinitialisation du mot de passe utilisent aussi BREVO_API_KEY et MAIL_FROM_EMAIL.
# Si ces clés sont vides, l’interface indique que l’envoi n’est pas disponible et ne prétend jamais qu’un e-mail a été envoyé.
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=contact@onloutou.com
# MAIL_FROM_NAME=ONLOUTOU
# NOTIFY_EMAIL=contact@onloutou.com

# Swagger (/api/docs) : fermé en production sauf ENABLE_API_DOCS=1
# ENABLE_API_DOCS=0

ENABLE_DEV_SEED=0

# Script bootstrap (optionnel, sinon saisie masquée au clavier)
# ADMIN_BOOTSTRAP_PASSWORD=
