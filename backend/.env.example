# API ONLOUTOU — copier vers `backend/.env` (seul fichier lu par l’API)

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://onloutou:onloutou_dev@127.0.0.1:5433/onloutou

SESSION_SECRET=change-me-minimum-32-characters-long-secret
CSRF_SECRET=change-me-minimum-32-characters-csrf-secret

APP_ORIGIN=http://localhost:3000
TRUST_PROXY=0
COOKIE_SECURE=0

# Tests d’intégration (base dédiée, jamais la prod)
# DATABASE_URL=postgresql://onloutou:onloutou_dev@127.0.0.1:5433/onloutou_integration

# DigitalOcean Spaces — vide tant que MinIO / Spaces n’est pas configuré
# S3_ENDPOINT=
# S3_REGION=fra1
# S3_BUCKET_PUBLIC=
# S3_BUCKET_PRIVATE=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=0

ENABLE_DEV_SEED=0

# Script bootstrap (optionnel, sinon saisie masquée au clavier)
# ADMIN_BOOTSTRAP_PASSWORD=
